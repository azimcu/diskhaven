[Unit]
Description=DiskHaven TEST disk agent (virtual disks only; usb and sata off)
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/diskhaven-test/diskhaven-diskd.py /etc/diskhaven-test/diskd.json
Restart=on-failure
NoNewPrivileges=true
# no mount namespacing (ProtectSystem, PrivateTmp...): mounts must be visible to the host and the container

[Install]
WantedBy=multi-user.target
